listLayout.Parent = resultsFrame
listLayout.Padding = UDim.new(0, 3)
listLayout.SortOrder = Enum.SortOrder.LayoutOrder

-- // SCRIPT CORE //
local foundRemotePaths = {} -- Table to store the paths for copying

-- Function to generate the full, usable path of an instance
local function getFullPath(instance)
    local path = ""
    local current = instance
    while current and current ~= game do
        -- Use bracket notation for names that might not be valid identifiers
        path = "[\"" .. current.Name .. "\"]" .. path
        current = current.Parent
    end
    return "game" .. path
end

-- Function to add a result to the UI
local function addResult(text, color)
    local resultBox = Instance.new("TextBox")
    resultBox.Name = "Result"
    resultBox.Parent = resultsFrame
    resultBox.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
    resultBox.Size = UDim2.new(1, 0, 0, 25)
    resultBox.Font = Enum.Font.SourceSans
    resultBox.Text = text
    resultBox.TextColor3 = color
    resultBox.TextSize = 14
    resultBox.ClearTextOnFocus = false
    resultBox.TextEditable = false
    resultBox.TextXAlignment = Enum.TextXAlignment.Left
end

-- The main scan function
local function scanForRemotes()
    -- Clear previous results from UI and path list
    for _, child in ipairs(resultsFrame:GetChildren()) do
        if child:IsA("GuiObject") then
            child:Destroy()
        end
    end
    table.clear(foundRemotePaths)

    scanButton.Text = "Scanning..."
    task.wait() -- Allow UI to update

    local remoteCount = 0
    
    for _, descendant in ipairs(game:GetDescendants()) do
        if descendant:IsA("RemoteEvent") then
            local fullPath = getFullPath(descendant)
            addResult("[RemoteEvent] " .. fullPath, Color3.fromRGB(150, 255, 150)) -- Green
            table.insert(foundRemotePaths, fullPath)
            remoteCount = remoteCount + 1
        elseif descendant:IsA("RemoteFunction") then
            local fullPath = getFullPath(descendant)
            addResult("[RemoteFunction] " .. fullPath, Color3.fromRGB(255, 255, 150)) -- Yellow
            table.insert(foundRemotePaths, fullPath)
            remoteCount = remoteCount + 1
        end
    end
    
    resultsFrame.CanvasSize = UDim2.new(0, 0, 0, (25 + listLayout.Padding.Offset) * remoteCount)
    
    scanButton.Text = "Scan Complete (" .. remoteCount .. " found)"
    task.wait(2)
    scanButton.Text = "Scan For Remotes"
end

-- Connect the buttons to their functions
scanButton.MouseButton1Click:Connect(scanForRemotes)

copyButton.MouseButton1Click:Connect(function()
    if #foundRemotePaths > 0 then
        -- Most executors provide a global 'setclipboard' function
        setclipboard(table.concat(foundRemotePaths, "\n"))
        
        copyButton.Text = "Copied!"
        task.wait(2)
        copyButton.Text = "Copy All"
    else
        copyButton.Text = "Scan first!"
        task.wait(2)
        copyButton.Text = "Copy All"
    end
end)
